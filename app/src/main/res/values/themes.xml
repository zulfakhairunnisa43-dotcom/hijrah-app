<resources>
    <style name="Theme.Hijrah" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/green_dark</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <!-- ikon status bar putih supaya terbaca di atas header hijau -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorSecondaryContainer">@color/green_container</item>
        <item name="colorOnSecondaryContainer">@color/green_dark</item>
    </style>

    <style name="Widget.Hijrah.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
    </style>

    <style name="Widget.Hijrah.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>